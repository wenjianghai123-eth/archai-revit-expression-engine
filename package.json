{
  "name": "archai-expression-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "build": "vite build",
    "check:env": "node -e \"console.log('VITE_SUPABASE_URL set:', Boolean(process.env.VITE_SUPABASE_URL)); console.log('VITE_SUPABASE_ANON_KEY set:', Boolean(process.env.VITE_SUPABASE_ANON_KEY));\"",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "import:materials": "node scripts/import-materials.mjs",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.0.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "three": "^0.184.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
