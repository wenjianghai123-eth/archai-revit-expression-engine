# Production auth must use Supabase. AUTH_MODE=dev is local-only and is rejected
# when NODE_ENV=production.
AUTH_MODE=supabase
DATA_BACKEND=supabase
FILE_STORAGE=supabase

# Legacy /api/generate/* endpoints do not create generation jobs or debit credits.
# Keep both legacy flags disabled for production deployments.
ENABLE_LEGACY_GENERATION_ENDPOINTS=false
VITE_ENABLE_LEGACY_GENERATION_FALLBACK=false
ENABLE_PROVIDER_FALLBACK=false

# Backend-only Supabase values. Never expose SUPABASE_SERVICE_ROLE_KEY in VITE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
JWT_SECRET=replace-with-a-fixed-long-random-string
JWT_EXPIRES_IN=7d

# Frontend build-time values. After changing any VITE_* variable, run
# npm run build and redeploy the frontend bundle.
VITE_API_BASE_URL=
# Production defaults to hidden. Set true only when the preloaded showcase assets
# under public/cases are ready; development mode shows the entry automatically.
VITE_ENABLE_SHOWCASE_DEMO=false

# Image generation is fixed to API易 / nano-banana2 in the backend.
# Backend only; never expose this key through VITE_*.
APIYI_API_KEY=
APIYI_API_BASE_URL=https://api.apiyi.com
APIYI_IMAGE_TIMEOUT_MS=300000
APIYI_IMAGE_PROVIDER_ENABLED=true

# First administrator seed. Use npm run seed:admin after Supabase tables/RPC are
# ready. Public registration is forbidden; after this seed, admins create users
# from /admin only. The seed is idempotent for the same ADMIN_EMAIL/profile id.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME="ArchAI Admin"
ADMIN_INITIAL_CREDITS=1000
DEFAULT_INITIAL_CREDITS=100

CORS_ORIGIN=https://your-production-domain.com
PORT=8787
MAX_IMAGE_MB=10
MAX_MODEL_MB=500
ENABLE_MODEL_OPTIMIZATION=true
MODEL_OPTIMIZATION_THRESHOLD_MB=30
MODEL_PREVIEW_TARGET_FACES=200000
BLENDER_BIN=blender
GENERATION_JOB_RATE_LIMIT_PER_MINUTE=10

# Generation worker reliability. Use "embedded" for local JSON development.
# In production, set "external" on the API service and run npm run start:worker
# as a separate process with the same backend/Supabase/provider environment.
GENERATION_WORKER_MODE=external
GENERATION_WORKER_ID=
GENERATION_WORKER_CONCURRENCY=1
GENERATION_WORKER_POLL_MS=2000
GENERATION_JOB_LEASE_MS=60000
GENERATION_JOB_HEARTBEAT_MS=20000
GENERATION_JOB_TIMEOUT_MS=600000
GENERATION_JOB_MAX_ATTEMPTS=3
GENERATION_RETRY_BASE_DELAY_MS=2000
GENERATION_RETRY_MAX_DELAY_MS=60000
